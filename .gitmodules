[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "mockthat"]
	path = mockthat
	url = https://github.com/nbenn/mockthat
[submodule "prt"]
	path = prt
	url = https://github.com/nbenn/prt
[submodule "reactives"]
	path = reactives
	url = https://github.com/nbenn/reactives
[submodule "typedjson"]
	path = typedjson
	url = https://github.com/nbenn/typedjson
